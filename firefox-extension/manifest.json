{
  "manifest_version": 2,
  "name": "Claude Monitor",
  "version": "1.2",
  "description": "Reads Claude.ai usage stats and sends them to the GNOME top bar indicator.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{40d3ec5d-53cc-42ad-bc0f-29799fcb4aee}",
      "strict_min_version": "91.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "https://claude.ai/*"
  ],
  "icons": {
    "48": "icon48.png",
    "96": "icon96.png"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  }
}
